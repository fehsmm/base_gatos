# 2. Rename the copy to: application-secrets.properties
#    (remove the ".example" suffix)
# 3. Replace the placeholders below with the real values
# 4. Restart the application
#
# The real application-secrets.properties is in .gitignore
# and will NEVER be committed to Git. This is intentional.
# ============================================================

# Email service (Gmail App Password)
# Ask a team admin for the current Gmail App Password.
# See: https://myaccount.google.com/apppasswords
spring.mail.username=grupobasedegatos@gmail.com
spring.mail.password=REPLACE_WITH_GMAIL_APP_PASSWORD

# Stripe API keys (TEST mode)
# Get these from https://dashboard.stripe.com → Developers → API keys
# Make sure "Test mode" toggle is ON before copying.
stripe.api.key=REMOVIDO_WITH_REAL_SECRET_KEY
stripe.publishable.key=pk_test_REPLACE_WITH_REAL_PUBLISHABLE_KEY